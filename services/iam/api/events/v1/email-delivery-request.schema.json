{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distributed-workflow.dev/iam/events/v1/email-delivery-request.schema.json",
  "title": "IAM Email Delivery Request",
  "description": "An envelope-encrypted request for Notifications to deliver an IAM email.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "envelope"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "iam.email-delivery-request"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "wrapped_key",
        "nonce",
        "ciphertext"
      ],
      "properties": {
        "algorithm": {
          "const": "RSA-OAEP-256+A256GCM"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "wrapped_key": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "nonce": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "ciphertext": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    }
  }
}
