{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distributed-workflow.dev/iam/events/v1/email-payload.schema.json",
  "title": "IAM Email Delivery Payload",
  "description": "The plaintext contract inside an IAM email-delivery-request envelope. This document is encrypted before persistence or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipient",
    "template",
    "variables"
  ],
  "properties": {
    "recipient": {
      "type": "string",
      "format": "email"
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
